      ["Puis-je annuler une anonymisation ou une suppression ?", "Non : l'archive Excel est la seule copie qui reste. C'est pourquoi elle doit être téléchargée et son enregistrement confirmé avant le traitement."],
      ["Un dossier anonymisé revient-il dans la liste ?", "Non : il est inscrit à l'historique et n'est plus proposé."],
      ["Pourquoi un dossier n'apparaît pas ?", "Sa date est vide, sa durée de conservation n'est pas atteinte (ou pas dans les 3 prochains mois), il ne remplit pas la condition de la règle, il est en attente, ou il a déjà été anonymisé."],
      ["Que se passe-t-il si le traitement s'arrête en cours ?", "Les dossiers sont traités par lots. Le message indique combien l'ont été ; ceux-là sont inscrits à l'historique, les autres restent dans la liste."],
      ["Où est rangé l'historique ?", "Dans la table « " + DEF_JO.titre + " », visible dans Données source. Elle ne contient que des numéros de ligne, jamais de données des dossiers."]
    ];
    q.forEach(function(x) {
      corps.appendChild(creer("h3", { texte: x[0] }));
      corps.appendChild(creer("p", { texte: x[1] }));
    });
  }
  p.appendChild(corps);
}
function rendreMessage(vue) {
  etat.vue = vue;
  rendreOnglets();
  var zone = contenu();
  vider(zone);
  zone.className = "w-contenu";
  var textes = {
    acces: ["Accès au document nécessaire", "Ce widget a besoin d'un accès complet au document pour lire les dossiers et enregistrer l'historique. Accordez-le dans le panneau de configuration du widget, à droite (niveau d'accès « Accès complet au document »)."],
    hors: ["Widget à ajouter dans un document", "Ce widget s'utilise dans un document : ajoutez-le à une page en tant que vue personnalisée."],
    recharger: ["La règle est créée", "La table de l'historique sera lisible après un rechargement du widget."],
    aucun: ["Aucune règle d'archivage pour l'instant", etat.peutParametrer ? "Créez une première règle : la table des dossiers, leur durée de conservation et ce qu'il faut anonymiser." : "Une personne qui peut paramétrer le document doit d'abord créer une règle d'archivage."],
    echec: ["Chargement impossible", "Les données du document n'ont pas pu être lues. Réessayez dans un instant."]
  };
  var t = textes[vue] || textes.echec;
  var bloc = creer("div", { classe: "w-vide" }, [creer("h2", { classe: "fr-h4 w-titre-vue", id: "titreVue", texte: t[0], attrs: { tabindex: "-1" } }), creer("p", { classe: "w-texte", texte: t[1] })]);
  if (vue === "aucun" && etat.peutParametrer) {
    bloc.appendChild(bouton("Créer une règle", null, "add-line", ouvrirCreation, { id: "mCreer" }));
  }
  if (vue === "recharger") {
    bloc.appendChild(bouton("Recharger le widget", null, "refresh-line", function() {
      window.location.reload();
    }, { id: "mRecharger" }));
  }
  if (vue === "echec" || vue === "acces") {
    bloc.appendChild(bouton("Réessayer", null, "refresh-line", function() {
      return chargerTout();
    }, { id: "mReessayer" }));
  }
  zone.appendChild(bloc);
}
async function chargerTout() {
  afficherLoader("Chargement des règles d'archivage…");
  etat.enCours = true;
  try {
    await chargerMeta();
    await lireCentrale();
    majDroits();
    resoudreTables();
    if (!etat.config) {
      etat.config = normaliserConfig({});
    }
    var l = regles();
    if (!l.length) {
      masquerLoader();
      etat.enCours = false;
      if (etat.peutParametrer && (etat.niveauAcces === null || etat.niveauAcces === "full")) {
        ouvrirCreation();
      } else {
        rendreMessage("aucun");
      }
      return;
    }
    var pref = lirePref("regle", null);
    choisirRegle(l.some(function(r) {
      return r.id === pref;
    }) ? pref : l[0].id);
    etat.signature = "";
    if (etat.meta.tables[regleCourante().table]) {
      await chargerDonnees();
    }
    masquerLoader();
    etat.enCours = false;
    rendrePrincipal();
  } catch (e) {
    masquerLoader();
    etat.enCours = false;
    var m = String(e && (e.message || e) || "");
    rendreMessage(/access|permission|full/i.test(m) ? "acces" : "echec");
    logSecurite("ERREUR", "Chargement impossible", e);
  }
}
function planifierRafraichissement(delai) {
  clearTimeout(etat.minuterieRafraichir);
  etat.minuterieRafraichir = setTimeout(function() {
    relayer(rafraichir(false), "Rafraîchissement");
  }, delai || 500);
}
async function rafraichir(force) {
  if (etat.vue !== "principal") {
    return;
  }
  var r = regleCourante();
  if (!r || !etat.meta.tables[r.table]) {
    return;
  }
  if (!force && (etat.enCours || etat.dialogue || etat.ecrituresEnCours || etat.lecturesEnAttente)) {
    return;
  }
  etat.enCours = true;
  try {
    if (force) {
      etat.signature = "";
    }
    var change = await chargerDonnees(!force);
    if (change && etat.vue === "principal") {
      var actif = document.activeElement && document.activeElement.id;
      rendreScene();
      if (actif) {
        refocaliser(actif);
      }
    }
  } catch (e) {
    logSecurite("AVERTISSEMENT", "Relecture des dossiers impossible", e);
    if (Date.now() - etat.dernierAvisLenteur > 12e4) {
      etat.dernierAvisLenteur = Date.now();
      afficherToast("Le document répond lentement : la liste sera mise à jour dès qu'il répondra.", null, 8e3);
    }
  } finally {
    etat.enCours = false;
  }
}
async function initialiser() {
  if (_initialise) {
    return;
  }
  _initialise = true;
  try {
    etat.nomDoc = await gristAvecTimeout(grist.docApi.getDocName(), 5e3);
  } catch (e) {
    etat.nomDoc = null;
  }
  var pa = lirePref("aide", null);
  if (pa) {
    etat.aide.onglet = typeof pa.onglet === "number" ? pa.onglet : 0;
  }
  await chargerTout();
  if (pa && pa.ouverte) {
    etat.aide.ouverte = true;
    var p = document.getElementById("wAide");
    if (p) {
      p.hidden = false;
      rendreAide();
    }
    var b = document.getElementById("bAide");
    if (b) {
      b.setAttribute("aria-expanded", "true");
      b.classList.remove("fr-btn--secondary");
    }
  }
  relayer(chargerLogo(), "Logo du bandeau");
}
function brancherSocle() {
  var v = document.getElementById("bandeauVersion");
  if (v) {
    v.textContent = "v" + VERSION_WIDGET;
  }
  var h = document.getElementById("bandeauHomologue");
  if (h) {
    h.hidden = !HOMOLOGUE;
  }
  document.getElementById("wErreurFermer").addEventListener("click", masquerErreur);
  document.getElementById("wConfirmOui").addEventListener("click", function() {
    terminerConfirmation(true);
  });
  document.getElementById("wConfirmNon").addEventListener("click", function() {
    terminerConfirmation(false);
  });
  document.getElementById("bAide").addEventListener("click", function() {
    ouvrirAide(!etat.aide.ouverte);
  });
  document.addEventListener("keydown", function(e) {
    if (e.key !== "Escape" || document.getElementById("wConfirmOverlay").classList.contains("actif") || etat.dialogue) {
      return;
    }
    if (etat.aide.ouverte && document.getElementById("wAide").contains(document.activeElement)) {
      ouvrirAide(false);
      return;
    }
    if (etat.voletMobile) {
      ouvrirVoletMobile(false);
    }
  });
}
function demarrer() {
  brancherSocle();
  if (typeof grist === "undefined") {
    afficherLogoRepli();
    rendreMessage("hors");
    return;
  }
  grist.ready({ requiredAccess: "full", allowSelectBy: false });
  if (typeof grist.on === "function") {
    grist.on("message", function(m) {
      if (m && m.settings && m.settings.accessLevel) {
        etat.niveauAcces = m.settings.accessLevel;
      }
    });
  }
  grist.onRecords(function() {
    if (!_initialise) {
      relayer(initialiser(), "Initialisation");
    } else {
      planifierRafraichissement();
    }
  });
  setTimeout(function() {
    relayer(initialiser(), "Initialisation");
  }, DELAI_DEMARRAGE_MS);
  _minuterieActualisation = setInterval(function() {
    if (document.visibilityState === "visible" && etat.vue === "principal") {
      relayer(rafraichir(false), "Relecture");
    }
  }, DELAI_ACTUALISATION_MS);
  document.addEventListener("visibilitychange", function() {
    if (document.visibilityState === "visible" && etat.vue === "principal") {
      planifierRafraichissement();
    }
  });
  setTimeout(function() {
    window.addEventListener("unhandledrejection", function(evt) {
      logSecurite("ERREUR", "Promesse rejetée non capturée", evt ? evt.reason : void 0);
    });
  }, 1500);
}
demarrer();
</script>
